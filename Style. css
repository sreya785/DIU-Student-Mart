/* ===== GLOBAL ===== */
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Segoe UI', sans-serif; background: #f5f7f6; color: #1a1a1a; }
a { text-decoration: none; color: inherit; }
 
/* ===== NAVBAR ===== */
.navbar { background: #1D9E75; padding: 0 24px; height: 54px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 999; }
.nav-logo { font-size: 16px; font-weight: 600; color: #fff; cursor: pointer; display: flex; align-items: center; gap: 10px; }
.logo-box { background: #fff; border-radius: 6px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #1D9E75; }
.nav-links { display: flex; gap: 6px; align-items: center; }
.nav-links a { color: rgba(255,255,255,0.88); font-size: 13px; padding: 6px 12px; border-radius: 6px; transition: background 0.2s; }
.nav-links a:hover, .nav-links a.active { background: rgba(255,255,255,0.18); color: #fff; }
.btn-post { background: #fff !important; color: #0F6E56 !important; font-weight: 600 !important; }
.btn-post:hover { background: #e8f8f2 !important; }
 
/* ===== HERO ===== */
.hero { background: #E1F5EE; border-bottom: 1px solid #9FE1CB; padding: 44px 24px; text-align: center; }
.hero h1 { font-size: 28px; font-weight: 700; color: #085041; margin-bottom: 8px; }
.hero p { font-size: 14px; color: #0F6E56; margin-bottom: 22px; }
.search-bar { display: flex; gap: 8px; max-width: 560px; margin: 0 auto; flex-wrap: wrap; justify-content: center; }
.search-bar input { flex: 1; min-width: 200px; padding: 10px 14px; border: 1px solid #5DCAA5; border-radius: 8px; font-size: 13px; background: #fff; outline: none; }
.search-bar select { padding: 10px 12px; border: 1px solid #5DCAA5; border-radius: 8px; font-size: 13px; background: #fff; }
.search-bar button { background: #1D9E75; color: #fff; border: none; border-radius: 8px; padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; }
.search-bar button:hover { background: #0F6E56; }
 
/* ===== CONTAINER ===== */
.container { max-width: 1100px; margin: 0 auto; padding: 20px 24px; }
 
/* ===== CATEGORY PILLS ===== */
.cat-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
.cat-pill { background: #fff; border: 1px solid #ddd; border-radius: 20px; padding: 5px 14px; font-size: 12px; color: #555; cursor: pointer; transition: all 0.2s; }
.cat-pill:hover, .cat-pill.active { background: #E1F5EE; border-color: #5DCAA5; color: #085041; font-weight: 600; }
 
/* ===== SECTION HEADER ===== */
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.section-header h2 { font-size: 16px; font-weight: 600; }
.section-header a { font-size: 13px; color: #1D9E75; }
 
/* ===== GRID ===== */
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; margin-bottom: 24px; }
 
/* ===== CARD ===== */
.card { background: #fff; border: 1px solid #e8e8e8; border-radius: 10px; overflow: hidden; cursor: pointer; transition: border-color 0.2s, transform 0.15s; }
.card:hover { border-color: #5DCAA5; transform: translateY(-2px); }
.card-img { height: 100px; display: flex; align-items: center; justify-content: center; font-size: 32px; background: #f5f7f6; }
.card-body { padding: 10px; }
.card-title { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px; }
.card-price { font-size: 14px; font-weight: 700; color: #0F6E56; margin-bottom: 6px; }
.card-footer { display: flex; justify-content: space-between; align-items: center; }
.card-dept { font-size: 10px; color: #999; }
 
/* ===== BADGES ===== */
.badge { font-size: 10px; padding: 2px 8px; border-radius: 10px; font-weight: 600; }
.badge-available { background: #E1F5EE; color: #085041; }
.badge-used { background: #FAEEDA; color: #633806; }
.badge-digital { background: #EEEDFE; color: #3C3489; }
.badge-reserved { background: #FCEBEB; color: #791F1F; }
.badge-new { background: #EAF3DE; color: #27500A; }